#!/usr/bin/env bash
# angular-advanced CLI. mise.toml puts cli/bin/ on PATH, so it runs from anywhere: adv help

set -e  # Fail fast for module loading and arg parsing

# Commands use paths relative to angular-advanced/ (courses/..., demo, cli/...)
ROOT="$(realpath "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/../..")"
CALLER_DIR="$PWD"  # for paths given on the command line
cd "$ROOT"

# Source modules
for module in utils verify zips upgrade; do
  if [[ ! -f "$ROOT/cli/$module.sh" ]]; then
    echo "Error: Missing script module: cli/$module.sh"
    exit 1
  fi
  source "$ROOT/cli/$module.sh"
done

show_help() {
  echo "Usage: adv [command] [target]"
  echo ""
  echo "Commands:"
  echo "  install, i       Install npm packages (one package.json for everything)"
  echo "  verify, v        Verify directories build and serve"
  echo "  test-zips, tz    Check student zips match cli/student-zips.manifest (--bless to update)"
  echo "  upgrade, u       Upgrade every project to Angular [major] (default: latest) [extra packages]"
  echo "  slides, s        Slides: present, presenter view and editor on http://localhost:4300 (pdf [out]: export PDF)"
  echo "  help, h          Show this help"
  echo ""
  echo "Targets (verify):"
  echo "  -a, all          All courses and demo"
  echo "  demo             Demo directory only"
  echo "  [course]         Specific course (courses/[course]/step-*)"
  echo ""
  echo "Examples:"
  echo "  adv install          # npm install in angular-advanced/"
  echo "  adv verify all       # Verify all directories build and serve"
  echo "  adv verify di        # Verify courses/di/step-*"
  echo "  adv test-zips        # Students still get the same zips?"
  echo "  adv upgrade          # Next Angular major: bump package.json, run migrations everywhere"
  echo "  adv upgrade 23 @ng-bootstrap/ng-bootstrap@24  # also upgrade a library that blocks it"
  echo "  adv slides           # Present or edit the slides"
  echo "  adv slides pdf       # Export the slides to slides/out/angular-advanced.pdf"
}

# Resolve target to list of directories
resolve_target() {
  local target="$1"
  case "$target" in
    "-a"|"all")
      get_all_directories
      ;;
    "demo")
      echo "demo"
      ;;
    "")
      echo ""
      ;;
    *)
      get_course_directories "$target"
      ;;
  esac
}

# Parse arguments
command="${1:-help}"
target="${2:-}"

case "$command" in
  "install"|"i")
    npm install
    (cd slides && npm install)
    ;;

  "slides"|"s")
    if [[ "$target" == "pdf" ]]; then
      (cd slides && npm run pdf -- ${3:+--out "$(cd "$CALLER_DIR" && realpath -m "$3")"})
    else
      (cd slides && npm start)
    fi
    ;;

  "verify"|"v")
    set +e  # Directory-processing functions handle errors internally
    if [[ -z "$target" ]]; then
      echo "Error: Target required for verify command"
      show_help
      exit 1
    fi
    directories=($(resolve_target "$target"))
    if [[ ${#directories[@]} -eq 0 ]]; then
      echo "Error: Target '$target' not found"
      exit 1
    fi
    verify_directories "${directories[@]}"
    ;;

  "upgrade"|"u")
    shift
    upgrade_angular "$@"
    ;;

  "test-zips"|"tz")
    test_zips "$target"
    ;;

  "help"|"h"|"")
    show_help
    ;;

  *)
    echo "Error: Unknown command '$command'"
    show_help
    exit 1
    ;;
esac
